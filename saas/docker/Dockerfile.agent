# Moltbot Agent Container
# Runs a moltbot gateway instance for a single tenant

FROM node:22-alpine AS base

# Install runtime dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    && rm -rf /var/cache/apk/*

# Build stage
FROM base AS builder

WORKDIR /build

# Copy the main moltbot package
COPY package.json pnpm-lock.yaml ./
COPY patches/ ./patches/

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install dependencies
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source and build
COPY tsconfig.json ./
COPY src/ ./src/

RUN pnpm build

# Production stage
FROM node:22-alpine AS production

WORKDIR /app

# Install pnpm and runtime dependencies
RUN corepack enable && corepack prepare pnpm@latest --activate \
    && apk add --no-cache tini

# Copy package files
COPY package.json pnpm-lock.yaml ./
COPY patches/ ./patches/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile || pnpm install --prod

# Copy built application
COPY --from=builder /build/dist ./dist
COPY moltbot.mjs ./

# Create non-root user
RUN addgroup -g 1000 -S moltbot && \
    adduser -S moltbot -u 1000 -G moltbot && \
    mkdir -p /data/.moltbot && \
    chown -R moltbot:moltbot /data /app

USER moltbot

# Environment
ENV NODE_ENV=production
ENV MOLTBOT_STATE_DIR=/data/.moltbot
ENV MOLTBOT_GATEWAY_PORT=18789
ENV MOLTBOT_GATEWAY_BIND=0.0.0.0

# Data volume
VOLUME ["/data"]

# Expose gateway port
EXPOSE 18789

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:18789/health || exit 1

# Use tini as init system
ENTRYPOINT ["/sbin/tini", "--"]

# Start the gateway
CMD ["node", "moltbot.mjs", "gateway", "run", "--bind", "0.0.0.0", "--port", "18789"]
